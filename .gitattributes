# Sources
*.c     text diff=cpp
*.cc    text diff=cpp
*.cxx   text diff=cpp
*.cpp   text diff=cpp
*.cpi   text diff=cpp
*.c++   text diff=cpp
*.hpp   text diff=cpp
*.h     text diff=cpp
*.h++   text diff=cpp
*.hh    text diff=cpp

# Ensure Arduino sketches are detected as C++
*.ino   text diff=cpp linguist-language=C++

# Compiled Object files
*.slo   binary
*.lo    binary
*.o     binary
*.obj   binary
# Precompiled Headers
*.gch   binary
*.pch   binary
# Compiled Dynamic libraries
*.so    binary
*.dylib binary
*.dll   binary
# Compiled Static libraries
*.lai   binary
*.la    binary
*.a     binary
*.lib   binary
# Executables
*.exe   binary
*.out   binary
*.app   binary
# 3D models and print files (using Git LFS for large files + exclude from language stats)
*.blend filter=lfs diff=lfs merge=lfs -text linguist-vendored
*.stl filter=lfs diff=lfs merge=lfs -text linguist-vendored
*.gcode filter=lfs diff=lfs merge=lfs -text linguist-vendored linguist-generated
*.step filter=lfs diff=lfs merge=lfs -text linguist-vendored
*.stp filter=lfs diff=lfs merge=lfs -text linguist-vendored
*.obj filter=lfs diff=lfs merge=lfs -text linguist-vendored
*.fbx filter=lfs diff=lfs merge=lfs -text linguist-vendored

# Exclude 3D model directories from language detection
description/models/** linguist-vendored

# Images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.svg binary
*.kra binary

# Video files
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text

# Documents
*.pdf filter=lfs diff=lfs merge=lfs -text

# Archives
*.zip filter=lfs diff=lfs merge=lfs -text linguist-vendored
*.tar.gz filter=lfs diff=lfs merge=lfs -text linguist-vendored
*.rar filter=lfs diff=lfs merge=lfs -text linguist-vendored

# Additional 3D formats
*.gltf filter=lfs diff=lfs merge=lfs -text linguist-vendored

# Mark specific documentation/vendor directories
*.mhtml linguist-vendored
parts/** linguist-documentation
CONTRIBUTING.md linguist-documentation
GITHUB_SETUP.md linguist-documentation
PUBLISHING_SUMMARY.md linguist-documentation

# Ensure Arduino code is detected
src/Arduino/** linguist-detectable=true

# Python for future ROS2
*.py linguist-language=Python

# Mark URDF as XML for proper highlighting
*.urdf text linguist-language=XML